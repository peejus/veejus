{
  "name": "veejus",
  "version": "1.0.1",
  "description": "Beat-synced VJ app for firing silly clips and GIFs on the drop",
  "main": "./out/main/index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "icon": "rsvg-convert -w 1024 -h 1024 build/icon.svg -o build/icon.png",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "fixtures": "node scripts/make-fixtures.mjs",
    "fixtures:stress": "node scripts/make-fixtures.mjs --stress",
    "fixtures:audio": "tsx --tsconfig tsconfig.node.json scripts/make-audio-fixtures.ts",
    "analyze": "tsx --tsconfig tsconfig.node.json scripts/analyze-audio.ts",
    "fixtures:perf": "node scripts/make-fixtures.mjs --perf",
    "build:link": "node scripts/build-link.mjs",
    "soak": "node scripts/soak.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:mac-zip": "electron-vite build && node scripts/package-mac.mjs",
    "build:photodrop": "node scripts/build-photodrop.mjs"
  },
  "author": "Veejus",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
